# The environment of the SoapCLI container (docker-compose.yml reads it with `env_file`).
# The secrets of the profiles are not here: each workspace has its own, in workspaces/<name>/secrets.env.

# ---- Who can open the UI --------------------------------------------------------------------------------------------
# The UI is published on 127.0.0.1 only (see docker-compose.yml), so anybody on this machine can use it. Before you publish
# it on a network, set a login (it is HTTP Basic: put the server behind HTTPS) and restrict where it may call.
#SOAPCLI_UI_USER=alice
#SOAPCLI_UI_PASSWORD=choose-a-strong-one

# ---- Where it may call ------------------------------------------------------------------------------------------------
# Destination hosts, comma separated, wildcards allowed. Empty (or absent) means any host. A workspace can narrow this
# further with "allowedHosts" in its workspace.json, but never widen it.
#SOAPCLI_ALLOWED_HOSTS=mock,*.example.com

# ---- Other options (see the documentation of the web UI) ------------------------------------------------------------------
#SOAPCLI_NO_INSECURE_TLS=true
#SOAPCLI_MAX_BODY_MB=25
